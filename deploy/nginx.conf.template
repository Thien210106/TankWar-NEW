worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;

    # Limits apply before a request reaches the WebSocket game process.
    limit_conn_zone $binary_remote_addr zone=per_ip_connections:10m;
    limit_req_zone $binary_remote_addr zone=socket_handshakes:10m rate=10r/m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen ${PORT};
        server_name _;
        root /usr/share/nginx/html;
        index index.html;
        client_max_body_size 4k;

        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        # The game service has no externally published port. All WebSocket
        # handshakes must pass through these limits and the hosting provider's
        # HTTPS/WSS edge.
        location = /ws {
            limit_conn per_ip_connections 20;
            limit_req zone=socket_handshakes burst=10 nodelay;
            proxy_pass http://127.0.0.1:8080;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        location / {
            try_files $uri $uri/ /index.html;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        }
    }
}
